# 환경변수 키 목록이다. 이 파일에는 값을 적지 않고, 아래 위치의 실제 파일에 직접 채운다.
#   로컬 개발: infra/local/.env (이 파일을 복사해서 만든다. Git에서 제외된다)
#   맥미니 운영: deploy 계정의 ~/Projects/marketry/env/marketry.env (파일 권한 600)
# 로컬에는 외부 API 키와 운영 시크릿을 두지 않는다. 비워 두어도 화면 확인에는 지장이 없다.

# ── 로컬 전용 ──
# 로컬 API와 로컬 DB가 호스트에 열리는 포트. 운영 env에는 넣지 않는다
LOCAL_API_PORT=18081
LOCAL_DB_PORT=15432

# ── 로컬과 운영 공통 ──
# PostgreSQL marketry 사용자 비밀번호. 앱도 같은 키로 DB에 접속한다. 로컬은 임의의 값을 쓴다
POSTGRES_PASSWORD=

# Google 로그인 클라이언트 ID
GOOGLE_CLIENT_ID=
# Google 로그인 클라이언트 시크릿
GOOGLE_CLIENT_SECRET=

# 앱 토큰 서명 키, 32바이트 이상. 바꾸면 이미 발급된 액세스 토큰이 무효가 된다
AUTH_JWT_SECRET=

# 텔레그램 봇 토큰
TELEGRAM_BOT_TOKEN=
# 텔레그램 발송 대상 채팅방 ID
TELEGRAM_CHAT_ID=
# 개발자 채팅방 ID
DEVELOPER_CHAT_ID=

# 키움 REST API 앱 키
KIWOOM_APP_KEY=
# 키움 REST API 앱 시크릿
KIWOOM_APP_SECRET=
# 키움과 토스 호출만 거치는 HTTP 프록시 주소(오라클 서버 2의 tailnet 주소). 비우면 직접 연결한다
MARKETRY_PROXY_HOST=
# 키움 프록시 포트. 비우면 8888
MARKETRY_PROXY_PORT=

# 토스 Open API 클라이언트 ID
TOSS_CLIENT_ID=
# 토스 Open API 클라이언트 시크릿
TOSS_CLIENT_SECRET=

# ── 운영 전용 ──
# Cloudflare Tunnel 토큰. cloudflared 컨테이너에만 전달된다
TUNNEL_TOKEN=

# 아래 R2_* 는 backup.sh의 외부 업로드용이다. 비어 있으면 업로드를 건너뛴다
# Cloudflare R2 S3 엔드포인트(https://<계정ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=
# 백업을 올릴 R2 버킷 이름
R2_BUCKET=
# R2 액세스 키 ID
R2_ACCESS_KEY_ID=
# R2 시크릿 액세스 키
R2_SECRET_ACCESS_KEY=

# Local PostgreSQL and host Java process. Copy to .env before starting.
POSTGRES_PASSWORD=market_monitor_local
LOCAL_API_PORT=18081
LOCAL_DB_PORT=15432

# Leave these empty to start the API without external integrations.
# Add real credentials only when testing their API endpoints.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEVELOPER_CHAT_ID=
ADMIN_TOKENS=
KRX_ID=
KRX_PW=

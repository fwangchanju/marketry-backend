# deploy 계정의 ~/Projects/marketry/env/marketry.env 에 들어갈 키 목록이다. 값은 손으로 채운다. 이 파일에는 값을 적지 않는다.
# 파일 권한은 600으로 둔다.

# PostgreSQL 컨테이너의 marketry 사용자 비밀번호. 앱도 같은 키로 DB에 접속한다
POSTGRES_PASSWORD=

# Cloudflare Tunnel 토큰. cloudflared 컨테이너에만 전달된다
TUNNEL_TOKEN=

# Google 로그인 클라이언트 ID
GOOGLE_CLIENT_ID=
# Google 로그인 클라이언트 시크릿
GOOGLE_CLIENT_SECRET=

# 앱 토큰 서명 키, 32바이트 이상. 바꾸면 전원 로그아웃된다
AUTH_JWT_SECRET=

# 텔레그램 봇 토큰
TELEGRAM_BOT_TOKEN=
# 텔레그램 발송 대상 채팅방 ID
TELEGRAM_CHAT_ID=
# 개발자 채팅방 ID
DEVELOPER_CHAT_ID=

# 키움 REST API 앱 키
KIWOOM_APP_KEY=
# 키움 REST API 앱 시크릿
KIWOOM_APP_SECRET=
# 키움 호출만 거치는 HTTP 프록시 주소(오라클 서버 2의 tailnet 주소). 비우면 직접 연결한다
MARKETRY_PROXY_HOST=
# 키움 프록시 포트. 비우면 8888
MARKETRY_PROXY_PORT=

# 토스 Open API 클라이언트 ID
TOSS_CLIENT_ID=
# 토스 Open API 클라이언트 시크릿
TOSS_CLIENT_SECRET=

# KRX 로그인 ID
KRX_ID=
# KRX 로그인 비밀번호
KRX_PW=

# 아래 R2_* 는 backup.sh의 외부 업로드용이다. 비어 있으면 업로드를 건너뛴다
# Cloudflare R2 S3 엔드포인트(https://<계정ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=
# 백업을 올릴 R2 버킷 이름
R2_BUCKET=
# R2 액세스 키 ID
R2_ACCESS_KEY_ID=
# R2 시크릿 액세스 키
R2_SECRET_ACCESS_KEY=

# These rules apply to shell commands requested outside the sandbox.
prefix_rule(
    pattern = [["sudo", "ssh", "scp", "sftp", "rsync", "kubectl", "helm"]],
    decision = "forbidden",
    justification = "Production server access and direct deployment are forbidden; use GitHub Actions.",
    match = ["ssh production.example"],
)

prefix_rule(
    pattern = ["bash", ["infra/scripts/deploy.sh", "infra/scripts/deploy-application.sh", "infra/scripts/deploy-nginx.sh", "infra/scripts/deploy-renderer.sh"]],
    decision = "forbidden",
    justification = "Do not deploy directly from the server terminal; use GitHub Actions.",
    match = ["bash infra/scripts/deploy-application.sh"],
)

prefix_rule(
    pattern = ["sh", ["infra/scripts/deploy.sh", "infra/scripts/deploy-application.sh", "infra/scripts/deploy-nginx.sh", "infra/scripts/deploy-renderer.sh"]],
    decision = "forbidden",
    justification = "Do not deploy directly from the server terminal; use GitHub Actions.",
    match = ["sh infra/scripts/deploy.sh"],
)

prefix_rule(
    pattern = [["./infra/scripts/deploy.sh", "./infra/scripts/deploy-application.sh", "./infra/scripts/deploy-nginx.sh", "./infra/scripts/deploy-renderer.sh"]],
    decision = "forbidden",
    justification = "Do not deploy directly from the server terminal; use GitHub Actions.",
    match = ["./infra/scripts/deploy-nginx.sh"],
)

prefix_rule(
    pattern = [["docker", "docker-compose"]],
    decision = "prompt",
    justification = "Confirm an isolated local Docker daemon and local Compose project; production Docker is forbidden.",
    match = ["docker compose -p marketry-local up -d"],
)
